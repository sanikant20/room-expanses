PORT=5000
NODE_ENV=development

# Production uses MongoDB Atlas. Use the mongodb+srv:// connection string.
# If Node's SRV resolution fails (querySrv ECONNREFUSED), use the direct
# replica-set form below (grab hostnames + replicaSet name from the TXT/SRV
# records of your cluster):
# mongodb://user:pass@shard0-host:27017,shard1-host:27017,shard2-host:27017/?replicaSet=<rs-name>&authSource=admin&tls=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/room-expanses
DB_NAME=room-expanses

ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=30d

CORS_ORIGIN=http://localhost:5173

# --- Email notifications (Resend, free tier) ---
# Get a free API key from https://resend.com (no signup cost; ~3,000 emails/mo).
# If not set, email sending is skipped silently — in-app notifications still work.
RESEND_API_KEY=
# Verified sender address, e.g. "The Roomies <hello@yourdomain.com>".
# The domain must be verified in Resend (Sending Domains) or sends fail with 403.
# The completing partner's email is set as reply-to so replies reach them.
# Leave blank to use Resend's onboarding address (can only send to your own
# account email until a domain is added).
EMAIL_FROM=
# Fallback sender domain used only when EMAIL_FROM is blank. Optional.
# Example: RESEND_DOMAIN=yourdomain.com
RESEND_DOMAIN=

# --- Cloudinary (avatar/image storage) ---
# Free tier: 25GB storage, 25K transformations/mo.
# Partner images are uploaded here; only the URL is stored in MongoDB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
