# Production values for Render (Web Service)
PORT=10000
NODE_ENV=production

# Atlas connection string (replace user/password)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=Cluster0
DB_NAME=room-expanses

# Long random strings (openssl rand -hex 32)
ACCESS_TOKEN_SECRET=replace-me-access-token-secret
REFRESH_TOKEN_SECRET=replace-me-refresh-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=30d

# The exact deployed frontend origin (no trailing slash)
CORS_ORIGIN=https://<your-frontend>.onrender.com

# --- Email notifications (Resend, free tier) ---
# REQUIRED for emails in production. Get a free key from https://resend.com.
# If omitted, email sending is skipped silently — in-app notifications still work.
RESEND_API_KEY=
# REQUIRED for emails in production. Verified sender, e.g.
# "The Roomies <hello@yourdomain.com>". The domain must be verified in Resend
# (Sending Domains) or sends fail with 403. The completing partner's email is
# set as reply-to so replies reach them.
EMAIL_FROM=
# Fallback sender domain when EMAIL_FROM is blank. Optional.
RESEND_DOMAIN=

# --- Cloudinary (avatar/image storage) ---
# Free tier: 25GB storage, 25K transformations/mo.
# Partner images are uploaded here; only the URL is stored in MongoDB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
